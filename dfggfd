local function StartLibrary()
	if StartupStarted then
		return
	end
	StartupStarted = true
	Gui.Enabled = true
	task.spawn(function()
		if IntroText then
			RunSplash(IntroText)
		end
		if GreetingText then
			RunGreeting(GreetingText)
		end
		ShowMenu()
	end)
end

function Library:CreateLib(title, theme)
	if WindowObject then
		return WindowObject
	end
	Title.Text = tostring(title or "USURE")
	Subtitle.Text = tostring(theme or "CONTROL")
	Gui.Enabled = false
	Splash.Visible = false
	Greeting.Visible = false
	Menu.Visible = false
	WindowObject = Library
	return WindowObject
end

function Library:CreateIntro(text)
	IntroText = text
	return self
end

function Library:CreateGreeting(text)
	GreetingText = text
	return self
end

function Library:NewTab(name)
	local order = 1
	for _ in pairs(Tabs) do order += 1 end
	local tab = MakeTabObject(name, order)
	if not StartupStarted then
		task.defer(function()
			if not StartupStarted then
				StartLibrary()
			end
		end)
	end
	CurrentTabObject = tab
	CurrentSectionObject = nil
	if order == 1 then
		CurrentTab = name
		Pages[name].Visible = true
		for n, page in pairs(Pages) do page.Visible = n == name end
		for n, data in pairs(Tabs) do
			local active=n==name
			data.Button.BackgroundColor3=active and C.Panel4 or C.Panel2
			data.Text.TextColor3=active and C.White or C.Gray
			data.Icon.TextColor3=active and C.White or C.Gray2
			data.Indicator.Visible=active
		end
	end
	return tab
end

function Library:NewSection(title, rightText)
	if not CurrentTabObject then
		CurrentTabObject = self:NewTab("MAIN")
	end
	return CurrentTabObject:NewSection(title, rightText)
end

function Library:NewButton(name, description, callback)
	if not CurrentSectionObject then self:NewSection("MAIN") end
	return CurrentSectionObject:NewButton(name, description, callback)
end

function Library:NewTextBox(name, description, callback, default)
	if not CurrentSectionObject then self:NewSection("MAIN") end
	return CurrentSectionObject:NewTextBox(name, description, callback, default)
end

function Library:NewToggle(name, description, callback, default)
	if not CurrentSectionObject then self:NewSection("MAIN") end
	return CurrentSectionObject:NewToggle(name, description, callback, default)
end

function Library:NewSlider(name, description, min, max, default, callback)
	if not CurrentSectionObject then self:NewSection("MAIN") end
	return CurrentSectionObject:NewSlider(name, description, min, max, default, callback)
end

function Library:NewDropdown(name, description, options, callback)
	if not CurrentSectionObject then self:NewSection("MAIN") end
	return CurrentSectionObject:NewDropdown(name, description, options, callback)
end

function Library:NewKeybind(name, description, key, callback)
	if not CurrentSectionObject then self:NewSection("MAIN") end
	return CurrentSectionObject:NewKeybind(name, description, key, callback)
