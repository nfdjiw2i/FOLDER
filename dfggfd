	b.MouseLeave:Connect(function()
		if CurrentTab ~= name then
			Tween(b, {
				BackgroundColor3 = C.Panel2
			}, 0.12)

			Tween(text, {
				TextColor3 = C.Gray
			}, 0.12)
		end
	end)

	b.MouseButton1Click:Connect(function()
		CurrentTab = name

		for n, data in pairs(Tabs) do
			local active = n == name

			Tween(data.Button, {
				BackgroundColor3 = active and C.Panel4 or C.Panel2
			}, 0.16)

			Tween(data.Text, {
				TextColor3 = active and C.White or C.Gray
			}, 0.16)

			Tween(data.Icon, {
				TextColor3 = active and C.White or C.Gray2
			}, 0.16)

			data.Indicator.Visible = active
		end

		for n, page in pairs(Pages) do
			page.Visible = n == name
		end
	end)

	return b
end

