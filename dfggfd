local function RebuildElements(section)
	for i,e in ipairs(section.Elements) do
		if e.Frame and e.Frame.Parent then e.Frame.LayoutOrder=i end
	end
end

local function MakeDragHandle(frame,element)
	if not Library.Config.AllowReorder then return end
	local h=New("TextButton",{Size=UDim2.fromOffset(18,28),Position=UDim2.new(0,2,.5,-14),BackgroundTransparency=1,Text="⋮",TextColor3=C.Gray3,TextSize=13,Font=Enum.Font.Code,AutoButtonColor=false,ZIndex=80},frame)
	local active=false
	local startY=0
	h.InputBegan:Connect(function(input)
		if input.UserInputType==Enum.UserInputType.MouseButton1 then
			active=true
			startY=input.Position.Y
			frame.BackgroundColor3=C.Panel4
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if active and input.UserInputType==Enum.UserInputType.MouseMovement then
			if math.abs(input.Position.Y-startY)>4 then
				element.Dragging=true
			end
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType==Enum.UserInputType.MouseButton1 and active then
			active=false
			if element.Dragging then
				local center=frame.AbsolutePosition.Y+frame.AbsoluteSize.Y/2
				local current
				for i,e in ipairs(element.Section.Elements) do if e==element then current=i break end end
				local target=#element.Section.Elements
				for i,e in ipairs(element.Section.Elements) do
					if e~=element and e.Frame and center < e.Frame.AbsolutePosition.Y+e.Frame.AbsoluteSize.Y/2 then target=i break end
				end
				if current then
					table.remove(element.Section.Elements,current)
					if target>current then target-=1 end
					table.insert(element.Section.Elements,math.clamp(target,1,#element.Section.Elements+1),element)
					RebuildElements(element.Section)
				end
			end
			element.Dragging=false
			frame.BackgroundColor3=C.Panel2
		end
	end)
end

