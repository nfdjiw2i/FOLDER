local function CreatePage(name)
	local page=New("ScrollingFrame",{
		Name=name,
		Size=UDim2.new(1,-28,1,-116),
		Position=UDim2.new(0,14,0,108),
		BackgroundTransparency=1,
		BorderSizePixel=0,
		ScrollBarThickness=2,
		ScrollBarImageColor3=C.White,
		ScrollBarImageTransparency=.72,
		CanvasSize=UDim2.fromOffset(0,0),
		AutomaticCanvasSize=Enum.AutomaticSize.None,
		ScrollingDirection=Enum.ScrollingDirection.Y,
		Visible=false,
		ZIndex=28,
		ClipsDescendants=true
	},Content)
	local left=New("Frame",{Name="LeftColumn",Size=UDim2.new(.5,-8,0,0),Position=UDim2.new(0,0,0,0),BackgroundTransparency=1,ZIndex=29},page)
	local right=New("Frame",{Name="RightColumn",Size=UDim2.new(.5,-8,0,0),Position=UDim2.new(.5,8,0,0),BackgroundTransparency=1,ZIndex=29,Visible=false},page)
	local ll=New("UIListLayout",{Padding=UDim.new(0,16),SortOrder=Enum.SortOrder.LayoutOrder,HorizontalAlignment=Enum.HorizontalAlignment.Center},left)
	local rl=New("UIListLayout",{Padding=UDim.new(0,16),SortOrder=Enum.SortOrder.LayoutOrder,HorizontalAlignment=Enum.HorizontalAlignment.Center},right)
	local function update()
		local leftHeight=ll.AbsoluteContentSize.Y
		local rightHeight=rl.AbsoluteContentSize.Y
		local h=right.Visible and math.max(leftHeight,rightHeight) or leftHeight
		if right.Visible then
			left.Size=UDim2.new(.5,-8,0,leftHeight)
			right.Size=UDim2.new(.5,-8,0,rightHeight)
		else
			left.Size=UDim2.new(1,0,0,leftHeight)
			right.Size=UDim2.new(.5,-8,0,0)
		end
		page.CanvasSize=UDim2.fromOffset(0,math.max(h,0)+20)
	end
	ll:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(update)
	rl:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(update)
	PageColumns[name]={Left=left,Right=right,LeftLayout=ll,RightLayout=rl,Update=update}
	Pages[name]=page
	return page
end

local function ActivateTab(name)
	if not Tabs[name] then return end
	CurrentTab=name
	for n,d in pairs(Tabs) do
		local active=n==name
		d.Page.Visible=active
		d.Button.BackgroundColor3=active and C.Panel2 or C.Black
		d.Text.TextColor3=active and C.White or C.Gray2
		d.Indicator.Visible=active
		if d.Border then d.Border.Color=active and C.White or C.Line end
		if d.ActiveMarks then for _,m in ipairs(d.ActiveMarks) do m.Visible=active end end
		if d.Icon then d.Icon.Visible=Library.Config.ShowIcons end
	end
	ContentTitle.Text=name
	ContentSubtitle.Text="// "..string.upper(name).." FUNCTIONS"
	CurrentTabObject=Tabs[name].Object
	CurrentSectionObject=nil
end

local function RebuildTabs()
	for i,name in ipairs(TabOrder) do
		if Tabs[name] then Tabs[name].Button.LayoutOrder=i end
	end
end

