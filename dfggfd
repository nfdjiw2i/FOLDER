		Stroke(p,C.Line2,1,.2)
		local d=outward and math.random(75,150) or math.random(18,42)
		Tween(p,{Position=UDim2.fromOffset(center.X+math.cos(a)*d-s/2,center.Y+math.sin(a)*d-s/2),Size=UDim2.fromOffset(2,2),BackgroundTransparency=1},.35)
		task.delay(.4,function()if p.Parent then p:Destroy()end end)
	end
end

local function CreateCollapseCube(pos)
	if CollapseCube and CollapseCube.Parent then CollapseCube:Destroy()end
	local position=pos or SavedCubePosition or UDim2.fromOffset(MenuCenter().X,MenuCenter().Y)
	SavedCubePosition=position
	local b=New("TextButton",{Size=UDim2.fromOffset(38,38),Position=position,AnchorPoint=Vector2.new(.5,.5),BackgroundColor3=C.Black2,BorderSizePixel=0,Text="[+]",TextColor3=C.White,TextSize=10,Font=Enum.Font.Code,AutoButtonColor=false,ZIndex=800},Gui)
	Stroke(b,C.White2,1,0)
	local drag=false
	b.InputBegan:Connect(function(i)if i.UserInputType==Enum.UserInputType.MouseButton1 then drag=true;CubeDragMoved=false;CubeDragStart=i.Position;CubeStartPosition=b.Position end end)
	b.InputEnded:Connect(function(i)if i.UserInputType==Enum.UserInputType.MouseButton1 then drag=false;if not CubeDragMoved and not Animating and Minimized then Library:Show()end end end)
	CollapseCube=b
	return b
end

function Library:Show()
	if Destroying then return end
	MenuOpen=true;Minimized=false
	if CollapseCube and CollapseCube.Parent then CollapseCube:Destroy();CollapseCube=nil end
	Gui.Enabled=true;Menu.Visible=true
end

function Library:Hide()
	if Destroying or Minimized then return end
	Minimized=true;MenuOpen=false
	local center=MenuCenter()
	Menu.Visible=false
	CollapseParticles(center,true)
	task.delay(.4,function()if Minimized and not Destroying then CreateCollapseCube()end end)
end

function Library:Toggle()
	if Minimized or not Menu.Visible then self:Show() else self:Hide()end
end

function Library:Destroy()
	if Destroying then return end
	Destroying=true;Menu.Visible=false
	if CollapseCube and CollapseCube.Parent then CollapseCube:Destroy()end
	local center=MenuCenter()
	CollapseParticles(center,true)
	task.delay(.5,function()if Gui.Parent then Gui:Destroy()end end)
	for _,c in ipairs(Connections)do pcall(function()c:Disconnect()end)end
end

MinButton.MouseButton1Click:Connect(function()Library:Toggle()end)
CloseButton.MouseButton1Click:Connect(function()Library:Destroy()end)
MaxButton.MouseButton1Click:Connect(function()
	Maxed=not Maxed
	if Maxed then Menu.Size=UDim2.new(1,-40,1,-40);Menu.Position=UDim2.new(0,20,0,20)
	else Menu.Size=UDim2.new(.965,0,.93,0);Menu.Position=UDim2.new(.0175,0,.035,0)end
end)

Header.InputBegan:Connect(function(i)if i.UserInputType==Enum.UserInputType.MouseButton1 then Dragging=true;DragStart=i.Position;StartPosition=Menu.Position end end)
UserInputService.InputChanged:Connect(function(i)
	if Dragging and i.UserInputType==Enum.UserInputType.MouseMovement then
		local d=i.Position-DragStart
		Menu.Position=UDim2.new(StartPosition.X.Scale,StartPosition.X.Offset+d.X,StartPosition.Y.Scale,StartPosition.Y.Offset+d.Y)
	end
	if CubeDragging and CollapseCube and CollapseCube.Parent and i.UserInputType==Enum.UserInputType.MouseMovement then
		local d=i.Position-CubeDragStart
		if math.abs(d.X)>4 or math.abs(d.Y)>4 then CubeDragMoved=true end
		CollapseCube.Position=UDim2.fromOffset(CubeStartPosition.X.Offset+d.X,CubeStartPosition.Y.Offset+d.Y)
		SavedCubePosition=CollapseCube.Position
	end
end)
UserInputService.InputEnded:Connect(function(i)if i.UserInputType==Enum.UserInputType.MouseButton1 then Dragging=false;CubeDragging=false end end)
UserInputService.InputBegan:Connect(function(i,processed)
	if processed or Destroying then return end
	if Library.Config.UseAltToggle and (i.KeyCode==Enum.KeyCode.LeftAlt or i.KeyCode==Enum.KeyCode.RightAlt) then Library:Toggle() end
	if i.KeyCode==Library.Config.ToggleKey then Library:Toggle() end
end)

RunService.RenderStepped:Connect(function(dt)
	if not Gui.Parent then return end
	local tm=TimeData()
	ClockTop.Text=tm
	local fps=math.floor(1/math.max(dt,1/240))
	StatusText.Text="GAME  : CONNECTED\nUSER  : "..Player.Name.."\nFPS   : "..tostring(fps).."\nTIME  : "..tm
end)

function Library:CreateLib(title,theme)
	if WindowObject then return WindowObject end
	Title.Text=tostring(title or "USURE")
	Subtitle.Text="// "..tostring(theme or "PRIVATE BUILD")
	WindowObject=self
	return self
end

function Library:CreateIntro(text)IntroText=text;return self end
function Library:CreateGreeting(text)GreetingText=text;return self end

function Library:NewTab(name,icon)
	local n=tostring(name or ("TAB_"..(#TabOrder+1)))
	local tab=CreateTab(n,icon)
	CurrentTabObject=tab
	CurrentSectionObject=nil
	if #TabOrder==1 then ActivateTab(n)end
	if not StartupStarted then
		StartupStarted=true
		Gui.Enabled=true
		task.spawn(function()
			if IntroText then RunSplash(IntroText)end
			if GreetingText then RunGreeting(GreetingText)end
			Library:Show()
		end)
	end
	return tab
end

function Library:SetTab(name)ActivateTab(name);return Tabs[name] and Tabs[name].Object end
function Library:SetTabOrder(order)
	local out={};local used={}
	for _,n in ipairs(order or {})do if Tabs[n]and not used[n]then table.insert(out,n);used[n]=true end end
	for _,n in ipairs(TabOrder)do if not used[n]then table.insert(out,n)end end
	TabOrder=out;RebuildTabs()
end

function Library:NewSection(title,rightText)
	if not CurrentTabObject then CurrentTabObject=self:NewTab("MAIN")end
	return CurrentTabObject:NewSection(title,rightText)
end
function Library:NewButton(n,d,c)if not CurrentSectionObject then self:NewSection("MAIN")end;return CurrentSectionObject:NewButton(n,d,c)end
function Library:NewToggle(n,d,c,v)if not CurrentSectionObject then self:NewSection("MAIN")end;return CurrentSectionObject:NewToggle(n,d,c,v)end
function Library:NewSlider(n,d,a,b,v,c)if not CurrentSectionObject then self:NewSection("MAIN")end;return CurrentSectionObject:NewSlider(n,d,a,b,v,c)end
function Library:NewDropdown(n,d,o,c)if not CurrentSectionObject then self:NewSection("MAIN")end;return CurrentSectionObject:NewDropdown(n,d,o,c)end
function Library:NewKeybind(n,d,k,c)if not CurrentSectionObject then self:NewSection("MAIN")end;return CurrentSectionObject:NewKeybind(n,d,k,c)end
function Library:NewPlayerList(n,d,c)if not CurrentSectionObject then self:NewSection("PLAYERS")end;return CurrentSectionObject:NewPlayerList(n,d,c)end
function Library:NewCollapse(n,d)if not CurrentSectionObject then self:NewSection("MAIN")end;return CurrentSectionObject:NewCollapse(n,d)end
function Library:NewList(n,d)return self:NewCollapse(n,d)end
