local function CreatePage(name)
	local page=New("ScrollingFrame",{Name=name,Size=UDim2.new(1,-28,1,-104),Position=UDim2.new(0,14,0,96),BackgroundTransparency=1,BorderSizePixel=0,ScrollBarThickness=2,ScrollBarImageColor3=C.White,ScrollBarImageTransparency=.78,CanvasSize=UDim2.new(),ScrollingDirection=Enum.ScrollingDirection.Y,Visible=false,ZIndex=28},Content)
	local left=New("Frame",{Name="LeftColumn",Size=UDim2.new(.5,-6,0,0),Position=UDim2.new(0,0,0,0),BackgroundTransparency=1,ZIndex=29},page)
	local right=New("Frame",{Name="RightColumn",Size=UDim2.new(.5,-6,0,0),Position=UDim2.new(.5,6,0,0),BackgroundTransparency=1,ZIndex=29},page)
	local ll=New("UIListLayout",{Padding=UDim.new(0,14),SortOrder=Enum.SortOrder.LayoutOrder},left)
	local rl=New("UIListLayout",{Padding=UDim.new(0,14),SortOrder=Enum.SortOrder.LayoutOrder},right)
	PageColumns[name]={Left=left,Right=right,LeftLayout=ll,RightLayout=rl}
	local function update()
		local h=math.max(ll.AbsoluteContentSize.Y,rl.AbsoluteContentSize.Y)
		left.Size=UDim2.new(.5,-6,0,h)
		right.Size=UDim2.new(.5,-6,0,h)
		page.CanvasSize=UDim2.fromOffset(0,h+18)
	end
	ll:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(update)
	rl:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(update)
	Pages[name]=page
	return page
end

local function ActivateTab(name)
	if not Tabs[name] then return end
	CurrentTab=name
	for n,d in pairs(Tabs) do
		local active=n==name
		d.Page.Visible=active
		d.Button.BackgroundColor3=active and C.Panel3 or C.Black
		d.Text.TextColor3=active and C.White or C.Gray
		d.Indicator.Visible=active
		if d.Border then d.Border.Color=active and C.White or C.Line end
		if d.Icon then d.Icon.Visible=Library.Config.ShowIcons end
	end
	ContentTitle.Text=name
	ContentSubtitle.Text="// "..string.upper(name).." FUNCTIONS"
	CurrentTabObject=Tabs[name].Object
	CurrentSectionObject=nil
end

local function RebuildTabs()
	for i,name in ipairs(TabOrder) do
