local function UseAbility()

    pcall(function()

        local tool = GetGloveTool()

        if tool then

            if tool:FindFirstChild("Ability") and tool.Ability:IsA("RemoteEvent") then

                tool.Ability:FireServer()

            end

            game:GetService("VirtualInputManager"):SendKeyEvent(true, Enum.KeyCode.E, false, game)

            task.wait(0.05)

            game:GetService("VirtualInputManager"):SendKeyEvent(false, Enum.KeyCode.E, false, game)

        end

    end)

end


local function IsTargetOffIsland(targetRoot)

    if not targetRoot then return true end

    local pos = targetRoot.Position

    if pos.Y < -30 then

        return true

    end

    local distFromCenter = Vector2.new(pos.X, pos.Z).Magnitude

    if distFromCenter > 380 then

        return true

    end

    return false

end


local function GetPortalPosition()

    local portal = Workspace:FindFirstChild("Lobby") and Workspace.Lobby:FindFirstChild("Teleport1")&#x20;

        or Workspace:FindFirstChild("Portal")&#x20;

        or Workspace:FindFirstChild("LobbyPortal")


    if portal then

        return portal:IsA("BasePart") and portal.Position or portal:GetPivot().Position

    end

    return Vector3.new(-8.17, -5.17, -5.80)

end


local function CreateAuraCircle()

    if SlapAuraVisualCircle then SlapAuraVisualCircle:Destroy() end

    local adornment = Instance.new("CylinderHandleAdornment")

    adornment.Name = "SlapAuraRadiusVisual"

    adornment.Color3 = Color3.fromRGB(0, 0, 0)

    adornment.Transparency = 0.3

    adornment.Height = 0.2

    adornment.CFrame = CFrame.Angles(math.rad(90), 0, 0)

    adornment.AlwaysOnTop = true

    SlapAuraVisualCircle = adornment

end


local function UpdateAuraCircle()

    local char = player.Character

    local root = char and char:FindFirstChild("HumanoidRootPart")

    if SlapAuraEnabled and root then

        if not SlapAuraVisualCircle or not SlapAuraVisualCircle.Parent then

            CreateAuraCircle()

        end

        SlapAuraVisualCircle.Radius = SlapAuraRadius

        SlapAuraVisualCircle.InnerRadius = math.max(0, SlapAuraRadius - 0.4)

        SlapAuraVisualCircle.Adornee = root

        SlapAuraVisualCircle.Parent = root

    else

        if SlapAuraVisualCircle then

            SlapAuraVisualCircle.Parent = nil

        end

    end

end


local function CreateHitboxCircle()

