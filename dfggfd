	Menu.Size = UDim2.fromOffset(760, 470)
	Menu.Position = UDim2.new(
		0.5,
		-380,
		0.5,
		-235
	)

	Tween(Menu, {
		Size = UDim2.fromOffset(900, 570),
		Position = UDim2.new(
			0.5,
			-450,
			0.5,
			-285
		),
		BackgroundTransparency = 0
	}, 0.65, Enum.EasingStyle.Quart)

