local function TimeData()
	local n=os.date("*t")
	local greeting
	if n.hour>=5 and n.hour<12 then greeting="GOOD MORNING"
	elseif n.hour<18 then greeting="GOOD AFTERNOON"
	elseif n.hour<23 then greeting="GOOD EVENING"
	else greeting="GOOD NIGHT" end
	local state=(Lighting.ClockTime>=6 and Lighting.ClockTime<18) and "DAY" or "NIGHT"
	return string.format("%02d:%02d:%02d",n.hour,n.min,n.sec),state,string.format("%02d.%02d.%04d",n.day,n.month,n.year),greeting
end

