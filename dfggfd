local function MakeSectionObject(page, title, rightText)
	local holder = Section(page, title, rightText)

	local object = {
		Frame = holder,
		Page = page
	}

	setmetatable(object, {
		__index = SectionMethods
	})

	return object
end

local function MakeTabObject(name, order)
	local page = CreatePage(name)
	CreateTab(name, order)

	local object = {
		Name = name,
		Page = page
	}

	function object:NewSection(title, rightText)
		local section = MakeSectionObject(page, title, rightText)
		CurrentSectionObject = section
		CurrentTabObject = object
		return section
	end

	function object:NewButton(name, description, callback)
		if not CurrentSectionObject or CurrentSectionObject.Page ~= page then
			CurrentSectionObject = self:NewSection("MAIN")
		end
		return CurrentSectionObject:NewButton(name, description, callback)
	end

	function object:NewTextBox(name, description, callback, default)
		if not CurrentSectionObject or CurrentSectionObject.Page ~= page then
			CurrentSectionObject = self:NewSection("MAIN")
		end
		return CurrentSectionObject:NewTextBox(name, description, callback, default)
	end

	function object:NewToggle(name, description, callback, default)
		if not CurrentSectionObject or CurrentSectionObject.Page ~= page then
			CurrentSectionObject = self:NewSection("MAIN")
		end
		return CurrentSectionObject:NewToggle(name, description, callback, default)
	end

	function object:NewSlider(name, description, min, max, default, callback)
		if not CurrentSectionObject or CurrentSectionObject.Page ~= page then
			CurrentSectionObject = self:NewSection("MAIN")
		end
		return CurrentSectionObject:NewSlider(name, description, min, max, default, callback)
	end

	function object:NewDropdown(name, description, options, callback)
		if not CurrentSectionObject or CurrentSectionObject.Page ~= page then
			CurrentSectionObject = self:NewSection("MAIN")
		end
		return CurrentSectionObject:NewDropdown(name, description, options, callback)
	end

	function object:NewKeybind(name, description, key, callback)
		if not CurrentSectionObject or CurrentSectionObject.Page ~= page then
			CurrentSectionObject = self:NewSection("MAIN")
		end
		return CurrentSectionObject:NewKeybind(name, description, key, callback)
	end

	function object:NewPlayerList(name, description, callback)
		if not CurrentSectionObject or CurrentSectionObject.Page ~= page then
			CurrentSectionObject = self:NewSection("PLAYERS")
		end
		return CurrentSectionObject:NewPlayerList(name, description, callback)
	end

	return object
end

