local function AddPlayerHighlight(target)

    if not HighlightEnabled or target == player then return end

    local character = target.Character

    if not character then return end


    local old = character:FindFirstChild("SStwendRT")

    if old then old:Destroy() end


    local highlight = Instance.new("Highlight")

    highlight.Name = "SStwendRT"

    highlight.OutlineColor = Color3.new(1, 1, 1)

    highlight.FillTransparency = 1

    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop

    highlight.Parent = character

end


local function SetupPlayerHighlight(target)

    if target == player then return end

    if HighlightConnections[target] then HighlightConnections[target]:Disconnect() end


    HighlightConnections[target] = target.CharacterAdded:Connect(function()

        task.wait(0.1)

        AddPlayerHighlight(target)

    end)


    AddPlayerHighlight(target)

end


local function RemovePlayerHighlight(target)

    if HighlightConnections[target] then

        HighlightConnections[target]:Disconnect()

        HighlightConnections[target] = nil

    end


    if target.Character then

        local highlight = target.Character:FindFirstChild("SStwendRT")

        if highlight then highlight:Destroy() end

    end

end


