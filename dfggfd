local function ControlFrame(parent, height)
	local f = New("Frame", {
		Size = UDim2.new(1, 0, 0, height),
		BackgroundColor3 = C.Panel2,
		BorderSizePixel = 0
	}, parent)

	Corner(f, 3)
	Stroke(f, C.Line, 1, 0)

	return f
end

local function CreateButton(parent, title, description, callback)
	local f = ControlFrame(parent, 56)

	local titleLabel = Label(
		f,
		title,
		10,
		C.White,
		Enum.Font.Gotham
	)

	titleLabel.Size = UDim2.new(1, -30, 0, 20)
	titleLabel.Position = UDim2.new(0, 13, 0, 7)

	local desc = Label(
		f,
		description or "",
		8,
		C.Gray2,
		Enum.Font.Gotham
	)

	desc.Size = UDim2.new(1, -30, 0, 17)
	desc.Position = UDim2.new(0, 13, 0, 29)

	local click = New("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 40
	}, f)

	click.MouseEnter:Connect(function()
		Tween(f, {
			BackgroundColor3 = C.Panel4
		}, 0.12)

		Tween(titleLabel, {
			TextColor3 = C.White
		}, 0.12)
	end)

	click.MouseLeave:Connect(function()
		Tween(f, {
			BackgroundColor3 = C.Panel2
		}, 0.12)
	end)

	click.MouseButton1Down:Connect(function()
		Tween(f, {
			BackgroundColor3 = C.Gray3
		}, 0.08)
	end)

	click.MouseButton1Up:Connect(function()
		Tween(f, {
			BackgroundColor3 = C.Panel4
		}, 0.08)
	end)

	click.MouseButton1Click:Connect(function()
		if callback then
			callback()
		end
	end)

	return {
		Frame = f,
		Button = click
	}
end


local function CreateTextBox(parent, title, description, callback, default)
	local f = ControlFrame(parent, 76)

	local titleLabel = Label(f, title, 13, C.White, Enum.Font.GothamSemibold)
	titleLabel.Size = UDim2.new(0.45, -13, 0, 18)
	titleLabel.Position = UDim2.new(0, 13, 0, 8)

	local desc = nil
	if description and tostring(description) ~= "" then
		desc = Label(f, description, 10, C.Gray2, Enum.Font.Gotham)
		desc.Size = UDim2.new(0.45, -13, 0, 17)
		desc.Position = UDim2.new(0, 13, 0, 29)
	end

	local box = New("TextBox", {
		Size = UDim2.new(0.48, -13, 0, 32),
		Position = UDim2.new(0.52, 0, 0.5, -16),
		BackgroundColor3 = C.Panel4,
		BorderSizePixel = 0,
		Text = default ~= nil and tostring(default) or "",
		PlaceholderText = "Enter text...",
		PlaceholderColor3 = C.Gray2,
		TextColor3 = C.White,
		TextSize = 11,
		Font = Enum.Font.Gotham,
		ClearTextOnFocus = false,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 45
	}, f)

	Corner(box, 3)
	Stroke(box, C.Line2, 1, 0)

	local padding = New("UIPadding", {
		PaddingLeft = UDim.new(0, 9),
		PaddingRight = UDim.new(0, 9)
	}, box)

	box.Focused:Connect(function()
		Tween(box, {BackgroundColor3 = C.Gray3}, 0.1)
	end)

	box.FocusLost:Connect(function(enterPressed)
		Tween(box, {BackgroundColor3 = C.Panel4}, 0.1)
		if callback then
			callback(box.Text, enterPressed)
		end
	end)

	return {
		Frame = f,
		TextBox = box,
		Get = function()
			return box.Text
		end,
		Set = function(_, value)
			box.Text = value ~= nil and tostring(value) or ""
		end
	}
end

local function CreateToggle(parent, title, description, callback, default)
	local f = ControlFrame(parent, 56)

	local titleLabel = Label(
		f,
		title,
		10,
		C.White,
		Enum.Font.Gotham
	)

	titleLabel.Size = UDim2.new(1, -100, 0, 20)
	titleLabel.Position = UDim2.new(0, 13, 0, 7)

	local desc = nil
	if description and tostring(description) ~= "" then
		desc = Label(
			f,
			description,
			8,
			C.Gray2,
			Enum.Font.Gotham
		)
		desc.Size = UDim2.new(1, -100, 0, 17)
		desc.Position = UDim2.new(0, 13, 0, 29)
	else
		titleLabel.Position = UDim2.new(0, 13, 0.5, -10)
	end

	local toggle = New("TextButton", {
		Size = UDim2.fromOffset(44, 24),
		Position = UDim2.new(1, -56, 0.5, -11),
		BackgroundColor3 = C.Panel4,
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 45
	}, f)

	Corner(toggle, 4)
	Stroke(toggle, C.Line2, 1, 0)

	local knob = New("Frame", {
		Size = UDim2.fromOffset(15, 15),
		Position = UDim2.new(0, 4, 0.5, -7),
		BackgroundColor3 = C.Gray2,
		BorderSizePixel = 0,
		ZIndex = 46
	}, toggle)

	Corner(knob, 3)

	local state = default == true

	local function ApplyState()
		if state then
			toggle.BackgroundColor3 = C.White
			knob.Position = UDim2.new(1, -18, 0.5, -7)
			knob.BackgroundColor3 = C.Black
		else
			toggle.BackgroundColor3 = C.Panel4
			knob.Position = UDim2.new(0, 4, 0.5, -7)
			knob.BackgroundColor3 = C.Gray2
		end
	end

	ApplyState()

	local rowButton = New("TextButton", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 44
	}, f)

	-- Keep the actual switch above the row hitbox.
	toggle.ZIndex = 45
	knob.ZIndex = 46

	local function SetToggleState(newState, animate)
		state = newState == true
		if animate then
			Tween(toggle, {BackgroundColor3 = state and C.White or C.Panel4}, 0.15)
			Tween(knob, {
				Position = state and UDim2.new(1, -18, 0.5, -7) or UDim2.new(0, 4, 0.5, -7),
				BackgroundColor3 = state and C.Black or C.Gray2
			}, 0.15)
		else
			ApplyState()
		end
		if callback then callback(state) end
	end

	rowButton.MouseButton1Click:Connect(function()
		SetToggleState(not state, true)
	end)

	toggle.MouseButton1Click:Connect(function()
		SetToggleState(not state, true)
	end)

	return {
		Frame = f,
		Button = rowButton,
		Toggle = toggle,
		Get = function()
			return state
		end,
		Set = function(_, newState)
			SetToggleState(newState, true)
		end
	}
end

local function CreateSlider(parent, title, description, min, max, default, callback)
	local f = ControlFrame(parent, 76)

	local titleLabel = Label(
		f,
		title,
		10,
		C.White,
		Enum.Font.Gotham
	)

	titleLabel.Size = UDim2.new(0.6, 0, 0, 20)
	titleLabel.Position = UDim2.new(0, 13, 0, 7)

	local valueLabel = Label(
		f,
		tostring(default),
		9,
		C.White,
		Enum.Font.Gotham
	)

	valueLabel.Size = UDim2.fromOffset(65, 20)
	valueLabel.Position = UDim2.new(1, -78, 0, 7)
	valueLabel.TextXAlignment = Enum.TextXAlignment.Right

	local desc = Label(
		f,
		description or "",
		8,
		C.Gray2,
		Enum.Font.Gotham
	)

	desc.Size = UDim2.new(1, -26, 0, 16)
	desc.Position = UDim2.new(0, 13, 0, 28)

	local bar = New("Frame", {
		Size = UDim2.new(1, -26, 0, 3),
		Position = UDim2.new(0, 13, 1, -13),
		BackgroundColor3 = C.Panel4,
		BorderSizePixel = 0,
		ZIndex = 42
	}, f)

	Corner(bar, 2)

	local ratio = (default - min) / (max - min)

	local fill = New("Frame", {
		Size = UDim2.new(ratio, 0, 1, 0),
		BackgroundColor3 = C.White,
		BorderSizePixel = 0,
		ZIndex = 43
	}, bar)

	Corner(fill, 2)

	local knob = New("Frame", {
		Size = UDim2.fromOffset(9, 9),
		Position = UDim2.new(ratio, -4, 0.5, -4),
		BackgroundColor3 = C.White,
		BorderSizePixel = 0,
		ZIndex = 44
	}, bar)

	Corner(knob, 5)

	local value = default
	local dragging = false

	local function SetFromX(x)
		local rel = math.clamp(
			(x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X,
			0,
			1
		)

		value = min + (max - min) * rel
		value = math.floor(value * 10 + 0.5) / 10

		fill.Size = UDim2.new(rel, 0, 1, 0)
		knob.Position = UDim2.new(rel, -4, 0.5, -4)
		valueLabel.Text = tostring(value)

		if callback then
			callback(value)
		end
	end

	bar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			SetFromX(input.Position.X)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
			SetFromX(input.Position.X)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
		end
	end)

	return {
		Frame = f,
		Get = function()
			return value
		end
	}
end

local function CreateDropdown(parent, title, description, options, callback)
	local f = ControlFrame(parent, 64)
	options = type(options) == "table" and options or {}
	if #options == 0 then
		options = {"NONE"}
	end

	local titleLabel = Label(
		f,
		title,
		10,
		C.White,
		Enum.Font.Gotham
	)

	titleLabel.Size = UDim2.new(0.5, 0, 0, 20)
	titleLabel.Position = UDim2.new(0, 13, 0, 7)

	local desc = Label(
		f,
		description or "",
		8,
		C.Gray2,
		Enum.Font.Gotham
	)

	desc.Size = UDim2.new(0.5, 0, 0, 16)
	desc.Position = UDim2.new(0, 13, 0, 29)

	local drop = New("TextButton", {
		Size = UDim2.fromOffset(145, 30),
		Position = UDim2.new(1, -158, 0.5, -15),
		BackgroundColor3 = C.Panel4,
		BorderSizePixel = 0,
		Text = tostring(options[1]),
		TextColor3 = C.White2,
		TextSize = 11,
		Font = Enum.Font.Gotham,
		AutoButtonColor = false,
		ZIndex = 60
	}, f)

	Corner(drop, 3)
	Stroke(drop, C.Line2, 1, 0)

	local list = New("Frame", {
		Size = UDim2.new(1, 0, 0, #options * 28),
		Position = UDim2.new(0, 0, 1, 4),
		BackgroundColor3 = C.Panel,
		BorderSizePixel = 0,
		Visible = false,
		ZIndex = 100
	}, drop)

	Corner(list, 3)
	Stroke(list, C.Line2, 1, 0)

	New("UIListLayout", {
		Padding = UDim.new(0, 1),
		SortOrder = Enum.SortOrder.LayoutOrder
	}, list)

	local selected = options[1]

	for _, option in ipairs(options) do
		local optionButton = New("TextButton", {
			Size = UDim2.new(1, 0, 0, 27),
			BackgroundColor3 = C.Panel2,
			BorderSizePixel = 0,
			Text = tostring(option),
			TextColor3 = C.Gray,
			TextSize = 11,
			Font = Enum.Font.Gotham,
			AutoButtonColor = false,
			ZIndex = 101
		}, list)

		optionButton.MouseEnter:Connect(function()
			Tween(optionButton, {
				BackgroundColor3 = C.Panel4,
				TextColor3 = C.White
			}, 0.1)
		end)

		optionButton.MouseLeave:Connect(function()
			Tween(optionButton, {
				BackgroundColor3 = C.Panel2,
				TextColor3 = C.Gray
			}, 0.1)
		end)

		optionButton.MouseButton1Click:Connect(function()
			selected = option
			drop.Text = tostring(option)
			list.Visible = false
			if callback then
				callback(selected)
			end
		end)
	end

	drop.MouseButton1Click:Connect(function()
		list.Visible = not list.Visible
	end)

	return {
		Frame = f,
		Button = drop,
		Get = function()
			return selected
		end
	}
end

local function CreateKeybind(parent, title, description, defaultKey, callback)
	local f = ControlFrame(parent, 56)
	local titleLabel = Label(f, title, 13, C.White, Enum.Font.GothamSemibold)
	titleLabel.Size = UDim2.new(0.55, 0, 0, 20)
	titleLabel.Position = UDim2.new(0, 13, 0, 7)
	local desc = Label(f, description or "", 10, C.Gray2, Enum.Font.Gotham)
	desc.Size = UDim2.new(0.55, 0, 0, 17)
	desc.Position = UDim2.new(0, 13, 0, 29)
	local bind = New("TextButton", {
		Size = UDim2.fromOffset(105, 30),
		Position = UDim2.new(1, -118, 0.5, -15),
		BackgroundColor3 = C.Panel4, BorderSizePixel = 0,
		Text = (defaultKey and defaultKey.Name) or "NONE", TextColor3 = C.White2,
		TextSize = 11, Font = Enum.Font.Gotham, AutoButtonColor = false, ZIndex = 50
	}, f)
	Corner(bind, 3)
	Stroke(bind, C.Line2, 1, 0)
	local key = defaultKey or Enum.KeyCode.Unknown
	local listening = false
	bind.MouseButton1Click:Connect(function()
		if listening then return end
		listening = true
		bind.Text = "PRESS KEY"
		local conn
		conn = UserInputService.InputBegan:Connect(function(input, processed)
			if processed then return end
			if input.UserInputType == Enum.UserInputType.Keyboard then
				key = input.KeyCode
				bind.Text = key.Name
				listening = false
				conn:Disconnect()
			end
		end)
	end)
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or listening or key == Enum.KeyCode.Unknown then return end
		if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == key then
			if callback then callback(key) end
		end
	end)
	return {Frame=f, Get=function() return key end}
end

local function CreateCollapse(parent, title, description)
	local holder = New("Frame", {Size=UDim2.new(1,0,0,44), BackgroundTransparency=1, ClipsDescendants=false}, parent)
	local button = New("TextButton", {Size=UDim2.new(1,0,0,44), BackgroundColor3=C.Panel2, BorderSizePixel=0, Text="", AutoButtonColor=false, ZIndex=50}, holder)
	Corner(button,3); Stroke(button,C.Line,1,0)
	local label = Label(button, title, 13, C.White, Enum.Font.GothamSemibold)
	label.Size=UDim2.new(1,-50,1,0); label.Position=UDim2.new(0,13,0,0)
	local arrow = Label(button, "›", 16, C.Gray, Enum.Font.Gotham)
	arrow.Size=UDim2.fromOffset(20,40); arrow.Position=UDim2.new(1,-32,0,0); arrow.TextXAlignment=Enum.TextXAlignment.Center
	local list = New("Frame", {Size=UDim2.new(1,0,0,0), Position=UDim2.new(0,0,0,44), BackgroundTransparency=1, Visible=false, ClipsDescendants=false}, holder)
	local layout = New("UIListLayout", {Padding=UDim.new(0,6), SortOrder=Enum.SortOrder.LayoutOrder}, list)
	local open=false
	local function resize()
		local h = layout.AbsoluteContentSize.Y
		list.Size=UDim2.new(1,0,0,h)
		holder.Size=UDim2.new(1,0,0,open and h+44 or 40)
	end
	layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(resize)
	button.MouseButton1Click:Connect(function()
		open=not open; list.Visible=open; arrow.Text=open and "⌄" or "›"; resize()
	end)
	local object={Frame=holder,List=list}
	function object:NewButton(name, desc, cb) return CreateButton(list,name,desc,cb) end
	function object:NewTextBox(name, desc, cb, default) return CreateTextBox(list,name,desc,cb,default) end
	function object:NewToggle(name, desc, cb, default) return CreateToggle(list,name,desc,cb,default) end
	function object:NewSlider(name, desc, min, max, default, cb) return CreateSlider(list,name,desc,min,max,default,cb) end
	return object
end

local function CreatePlayerList(parent, title, description, callback)
	local holder = New("Frame", {Size=UDim2.new(1,0,0,58), BackgroundColor3=C.Panel2, BorderSizePixel=0}, parent)
	Corner(holder,3); Stroke(holder,C.Line,1,0)
	local titleLabel=Label(holder,title,10,C.White,Enum.Font.Gotham); titleLabel.Size=UDim2.new(1,-26,0,20); titleLabel.Position=UDim2.new(0,13,0,7)
	local desc=Label(holder,description or "",8,C.Gray2,Enum.Font.Gotham); desc.Size=UDim2.new(1,-26,0,17); desc.Position=UDim2.new(0,13,0,29)
	local list=New("Frame", {Size=UDim2.new(1,0,0,0), Position=UDim2.new(0,0,1,4), BackgroundTransparency=1}, holder)
	local layout=New("UIListLayout", {Padding=UDim.new(0,4), SortOrder=Enum.SortOrder.Name}, list)
	local buttons={}
	local function rebuild()
		for _,b in pairs(buttons) do b:Destroy() end
		table.clear(buttons)
		for _,target in ipairs(Players:GetPlayers()) do
			if target ~= Player then
				local b=New("TextButton", {Size=UDim2.new(1,0,0,34), BackgroundColor3=C.Panel2, BorderSizePixel=0, Text=target.DisplayName.."  @"..target.Name, TextColor3=C.Gray, TextSize=9, Font=Enum.Font.Gotham, AutoButtonColor=false}, list)
				Corner(b,3); Stroke(b,C.Line,1,0)
				b.MouseEnter:Connect(function() Tween(b,{BackgroundColor3=C.Panel4,TextColor3=C.White},0.1) end)
				b.MouseLeave:Connect(function() Tween(b,{BackgroundColor3=C.Panel2,TextColor3=C.Gray},0.1) end)
				b.MouseButton1Click:Connect(function() if callback then callback(target) end end)
				table.insert(buttons,b)
			end
		end
		list.Size=UDim2.new(1,0,0,layout.AbsoluteContentSize.Y)
		holder.Size=UDim2.new(1,0,0,62+layout.AbsoluteContentSize.Y)
	end
	Players.PlayerAdded:Connect(rebuild); Players.PlayerRemoving:Connect(rebuild)
	task.defer(rebuild)
	return {Frame=holder,Refresh=rebuild}
end

