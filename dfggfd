local function RunSplash(customText)
	Splash.Visible = true
	Splash.BackgroundTransparency = 0
	SplashTitle.Text = tostring(customText or "USURE")
	for i = 0, 100 do
		LoadFill.Size = UDim2.new(i / 100, 0, 1, 0)

		if i < 25 then
			SplashStatus.Text = "INITIALIZING // " .. string.format("%02d", i) .. "%"
		elseif i < 50 then
			SplashStatus.Text = "LOADING CORE // " .. string.format("%02d", i) .. "%"
		elseif i < 75 then
			SplashStatus.Text = "BUILDING UI // " .. string.format("%02d", i) .. "%"
		elseif i < 95 then
			SplashStatus.Text = "FINALIZING // " .. string.format("%02d", i) .. "%"
		else
			SplashStatus.Text = "READY // " .. string.format("%02d", i) .. "%"
		end

		task.wait(0.008)
	end

	task.wait(0.25)

	Tween(SplashTitle, {
		TextTransparency = 1
	}, 0.35)

	Tween(SplashStatus, {
		TextTransparency = 1
	}, 0.35)

	Tween(LoadBack, {
		BackgroundTransparency = 1
	}, 0.35)

	Tween(LoadFill, {
		BackgroundTransparency = 1
	}, 0.35)

	for _, v in ipairs(Splash:GetDescendants()) do
		if v:IsA("UIStroke") then
			Tween(v, {
				Transparency = 1
			}, 0.35)
		elseif v:IsA("Frame") then
			if v ~= Splash then
				Tween(v, {
					BackgroundTransparency = 1
				}, 0.35)
			end
		end
	end

	Tween(Splash, {
		BackgroundTransparency = 1
	}, 0.45)

	task.wait(0.5)

	Splash:Destroy()
end

