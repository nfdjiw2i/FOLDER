end

local function CreateCollapseParticles(center, count, outward)
	local particles = {}
	local guiCenter = center or GetMenuCenter()
	local total = count or 10

	for i = 1, total do
		local angle = ((i - 1) / total) * math.pi * 2 + math.random(-20, 20) * 0.01
		local distance = math.random(70, 150)
		local size = math.random(4, 8)

		local particle = New("Frame", {
			Size = UDim2.fromOffset(size, size),
			Position = UDim2.fromOffset(
				guiCenter.X - size / 2,
				guiCenter.Y - size / 2
			),
			BackgroundColor3 = C.Black,
			BackgroundTransparency = 0.02,
			BorderSizePixel = 0,
			Rotation = math.random(0, 90),
			ZIndex = 600
		}, Gui)

		Corner(particle, 1)
		Stroke(particle, C.Line2, 1, 0.35)

		local targetDistance = outward and distance or math.random(18, 42)
		local target = Vector2.new(
			guiCenter.X + math.cos(angle) * targetDistance,
			guiCenter.Y + math.sin(angle) * targetDistance
		)

		Tween(particle, {
			Position = UDim2.fromOffset(
				target.X - size / 2,
				target.Y - size / 2
			),
			Size = UDim2.fromOffset(2, 2),
			Rotation = particle.Rotation + math.random(-160, 160),
			BackgroundTransparency = 0.2
		}, 0.34 + math.random() * 0.12, Enum.EasingStyle.Quart)

		task.delay(0.34, function()
			if particle and particle.Parent then
				Tween(particle, {
					BackgroundTransparency = 1
				}, 0.18)
				local stroke = particle:FindFirstChildOfClass("UIStroke")
				if stroke then
					Tween(stroke, {Transparency = 1}, 0.18)
				end
				task.delay(0.2, function()
					if particle and particle.Parent then
						particle:Destroy()
					end
				end)
			end
		end)

		table.insert(particles, particle)
	end

	return particles
end

local function CreateCollapseCube(position)
	if CollapseCube and CollapseCube.Parent then
		CollapseCube:Destroy()
	end

	local center = nil
	local cubePosition

	if typeof(position) == "UDim2" then
		cubePosition = position
	elseif position then
		center = position
		cubePosition = UDim2.fromOffset(position.X, position.Y)
	elseif SavedCubePosition then
		cubePosition = SavedCubePosition
	else
		center = GetMenuCenter()
		cubePosition = UDim2.fromOffset(center.X, center.Y)
	end

	SavedCubePosition = cubePosition

	local button = New("TextButton", {
		Size = UDim2.fromOffset(34, 34),
		Position = cubePosition,
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = C.Black2,
		BackgroundTransparency = 0.04,
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
		Active = true,
		Selectable = false,
		ZIndex = 700
	}, Gui)

	Corner(button, 7)
	local outerStroke = Stroke(button, C.Line2, 1, 0.1)

	local inner = New("Frame", {
		Size = UDim2.fromOffset(16, 16),
		Position = UDim2.new(0.5, -8, 0.5, -8),
		BackgroundColor3 = C.Panel3,
		BorderSizePixel = 0,
		ZIndex = 701
	}, button)

	Corner(inner, 4)
	Stroke(inner, C.Gray3, 1, 0.15)

	local slash = New("Frame", {
		Size = UDim2.fromOffset(11, 1),
		Position = UDim2.new(0.5, -5, 0.5, -1),
		Rotation = -45,
		BackgroundColor3 = C.White,
		BackgroundTransparency = 0.08,
		BorderSizePixel = 0,
		ZIndex = 702
	}, inner)

	local dot = New("Frame", {
		Size = UDim2.fromOffset(3, 3),
		Position = UDim2.new(0.5, -1.5, 0.5, -1.5),
		BackgroundColor3 = C.White,
		BorderSizePixel = 0,
		ZIndex = 703
	}, inner)

	Corner(dot, 2)

	local glow = New("Frame", {
		Size = UDim2.fromOffset(42, 42),
		Position = UDim2.new(0.5, -21, 0.5, -21),
		BackgroundColor3 = C.White,
		BackgroundTransparency = 0.985,
		BorderSizePixel = 0,
		ZIndex = 699
	}, button)

	Corner(glow, 21)

	local hovering = false
	button.MouseEnter:Connect(function()
		hovering = true
		Tween(button, {BackgroundColor3 = C.Panel4}, 0.12)
		Tween(outerStroke, {Transparency = 0}, 0.12)
		Tween(inner, {BackgroundColor3 = C.Panel4}, 0.12)
	end)

	button.MouseLeave:Connect(function()
		hovering = false
		Tween(button, {BackgroundColor3 = C.Black2}, 0.16)
		Tween(outerStroke, {Transparency = 0.1}, 0.16)
		Tween(inner, {BackgroundColor3 = C.Panel3}, 0.16)
	end)

	button.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			CubeDragging = true
			CubeDragMoved = false
			CubeDragStart = input.Position
			CubeStartPosition = button.Position
		end
	end)

	button.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			CubeDragging = false
			if not CubeDragMoved and not Animating and not Destroying and Minimized then
				task.defer(OpenMenuFromCube)
			end
		end
	end)

	CollapseCube = button
	return button
end

local function HideMenuToCube()
	if Animating or Destroying or Minimized then
		return
	end

	Animating = true
	Minimized = true
	MenuOpen = false

	local center = GetMenuCenter()

	-- Hide every menu element immediately so no buttons, labels or panels remain visible.
	Menu.Visible = false

	if CollapseCube and CollapseCube.Parent then
		CollapseCube:Destroy()
	end

	CreateCollapseParticles(center, 10, true)

	task.delay(0.42, function()
		if Destroying then
			return
		end
		if Minimized then
			CreateCollapseCube()
		end
		Animating = false
	end)
end

function OpenMenuFromCube()
	if Animating or Destroying or not Minimized then
		return
	end

	Animating = true
	Minimized = false
	MenuOpen = true

	local cubePosition = CollapseCube and Vector2.new(
		CollapseCube.AbsolutePosition.X + CollapseCube.AbsoluteSize.X / 2,
		CollapseCube.AbsolutePosition.Y + CollapseCube.AbsoluteSize.Y / 2
	) or GetMenuCenter()

	if CollapseCube and CollapseCube.Parent then
		CollapseCube:Destroy()
		CollapseCube = nil
	end

	CreateCollapseParticles(cubePosition, 10, false)

	Menu.Visible = true
	Menu.BackgroundTransparency = 1
	Tween(Menu, {
		BackgroundTransparency = 0
	}, 0.28, Enum.EasingStyle.Quart)

	task.delay(0.22, function()
		if Menu and Menu.Parent then
			Menu.Visible = true
		end
		Animating = false
	end)
end

local function DestroyMenu()
	if Animating or Destroying then
		return
	end

	Destroying = true
	MenuOpen = false
	Minimized = false

	local center
	if CollapseCube and CollapseCube.Parent then
		center = Vector2.new(
			CollapseCube.AbsolutePosition.X + CollapseCube.AbsoluteSize.X / 2,
			CollapseCube.AbsolutePosition.Y + CollapseCube.AbsoluteSize.Y / 2
		)
		CollapseCube:Destroy()
		CollapseCube = nil
	else
		center = GetMenuCenter()
	end

	-- The complete menu disappears immediately; only the ten black fragments remain.
	Menu.Visible = false

	CreateCollapseParticles(center, 10, true)

	task.delay(0.62, function()
		if Gui and Gui.Parent then
			Gui:Destroy()
		end
	end)
end

MinButton.MouseButton1Click:Connect(function()
	if Minimized then
		OpenMenuFromCube()
	else
		HideMenuToCube()
	end
end)

CloseButton.MouseButton1Click:Connect(function()
	DestroyMenu()
end)

local Dragging = false
local DragStart = nil
local StartPosition = nil

Header.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		Dragging = true
		DragStart = input.Position
		StartPosition = Menu.Position
	end
end)

Header.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		Dragging = false
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if CubeDragging and CollapseCube and CollapseCube.Parent and input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Position - CubeDragStart
		if math.abs(delta.X) > 4 or math.abs(delta.Y) > 4 then
			CubeDragMoved = true
		end

		CollapseCube.Position = UDim2.fromOffset(
			CubeStartPosition.X.Offset + delta.X,
			CubeStartPosition.Y.Offset + delta.Y
		)
		SavedCubePosition = CollapseCube.Position
		return
	end

	if Dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Position - DragStart

		Menu.Position = UDim2.new(
			StartPosition.X.Scale,
			StartPosition.X.Offset + delta.X,
			StartPosition.Y.Scale,
			StartPosition.Y.Offset + delta.Y
		)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		CubeDragging = false
		Dragging = false
	end
end)

UserInputService.InputBegan:Connect(function(input, processed)
	if processed or Destroying then
		return
	end

	if input.KeyCode == Enum.KeyCode.LeftAlt or input.KeyCode == Enum.KeyCode.RightAlt then
		if Minimized then
			OpenMenuFromCube()
		else
			HideMenuToCube()
		end
	end
end)

local GreetingConnection

local function RunGreeting(customText)
	Greeting.Visible = true

	Hello.TextTransparency = 1
	Username.TextTransparency = 1
	Clock.TextTransparency = 1
	Environment.TextTransparency = 1
	Welcome.TextTransparency = 1

	GreetingBox.Position =
		UDim2.new(0.5, -270, 0.5, -95)

	local function UpdateGreeting()
		if not Greeting.Parent then
			return
		end

		local timeString, state, dateString, greeting =
			GetGreetingData()

		Clock.Text = timeString
		Environment.Text = state .. " // " .. dateString
		Welcome.Text = tostring(customText or (greeting .. " // SESSION READY"))
	end

	UpdateGreeting()

	GreetingConnection = RunService.RenderStepped:Connect(function()
		UpdateGreeting()
	end)

	Tween(
		GreetingBox,
		{
			Position = UDim2.new(0.5, -270, 0.5, -125)
		},
		0.75,
		Enum.EasingStyle.Quart
	)

	Tween(Hello, {
		TextTransparency = 0
	}, 0.65)

	task.wait(0.12)

	Tween(Username, {
		TextTransparency = 0
	}, 0.55)

	task.wait(0.1)

	Tween(Clock, {
		TextTransparency = 0
	}, 0.55)

	Tween(Environment, {
		TextTransparency = 0
	}, 0.55)

	task.wait(0.12)

	Tween(Welcome, {
		TextTransparency = 0
	}, 0.55)

	task.wait(2.7)

	Tween(Hello, {
		TextTransparency = 1
	}, 1.15)

	Tween(Username, {
		TextTransparency = 1
	}, 1.15)

	Tween(Clock, {
		TextTransparency = 1
	}, 1.15)

	Tween(Environment, {
		TextTransparency = 1
	}, 1.15)

	Tween(Welcome, {
		TextTransparency = 1
	}, 1.15)

	Tween(
		GreetingBox,
		{
			Position = UDim2.new(0.5, -270, 0.5, -145)
		},
		1.15,
		Enum.EasingStyle.Quart
	)

	for _, obj in ipairs(Greeting:GetDescendants()) do
		if obj:IsA("UIStroke") then
			Tween(obj, {
				Transparency = 1
			}, 1.15)
		elseif obj:IsA("Frame") and obj ~= GreetingBox then
			Tween(obj, {
				BackgroundTransparency = 1
			}, 1.15)
		end
	end

	Tween(Greeting, {
		BackgroundTransparency = 1
	}, 1.15)

	task.wait(1.2)

	if GreetingConnection then
		GreetingConnection:Disconnect()
		GreetingConnection = nil
	end

	Greeting:Destroy()
end

