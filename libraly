	local indicator = New("Frame", {
		Size = UDim2.new(0, 2, 0, 20),
		Position = UDim2.new(0, 0, 0.5, -10),
		BackgroundColor3 = C.White,
		BorderSizePixel = 0,
		Visible = false,
		ZIndex = 31
	}, b)

	local icon = Label(b, "◆", 7, C.Gray2, Enum.Font.Code)
	icon.Size = UDim2.fromOffset(15, 20)
	icon.Position = UDim2.new(0, 12, 0.5, -10)
	icon.TextXAlignment = Enum.TextXAlignment.Center

	local text = Label(b, name, 10, C.Gray, Enum.Font.Code)
	text.Size = UDim2.new(1, -42, 1, 0)
	text.Position = UDim2.new(0, 35, 0, 0)

	Tabs[name] = {Button=b, Text=text, Icon=icon, Indicator=indicator}

	b.MouseEnter:Connect(function()
		if CurrentTab ~= name then
			Tween(b, {BackgroundColor3=C.Panel3}, 0.12)
			Tween(text, {TextColor3=C.White2}, 0.12)
		end
	end)

	b.MouseLeave:Connect(function()
		if CurrentTab ~= name then
			Tween(b, {BackgroundColor3=C.Panel2}, 0.12)
			Tween(text, {TextColor3=C.Gray}, 0.12)
		end
	end)

	b.MouseButton1Click:Connect(function()
		CurrentTab = name
		for n, data in pairs(Tabs) do
			local active = n == name
			Tween(data.Button, {BackgroundColor3=active and C.Panel4 or C.Panel2}, 0.16)
			Tween(data.Text, {TextColor3=active and C.White or C.Gray}, 0.16)
			Tween(data.Icon, {TextColor3=active and C.White or C.Gray2}, 0.16)
			data.Indicator.Visible = active
		end
		for n, page in pairs(Pages) do
			page.Visible = n == name
		end
	end)

	return b
end

local function SelectTab(name)
	local data = Tabs[name]
	if not data then return end
	CurrentTab = name
	for n, d in pairs(Tabs) do
		local active = n == name
		d.Button.BackgroundColor3 = active and C.Panel4 or C.Panel2
		d.Text.TextColor3 = active and C.White or C.Gray
		d.Icon.TextColor3 = active and C.White or C.Gray2
		d.Indicator.Visible = active
	end
	for n, page in pairs(Pages) do
		page.Visible = n == name
	end
end

