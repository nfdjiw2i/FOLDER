	local list=New("Frame", {Size=UDim2.new(1,-18,0,0),Position=UDim2.new(0,9,0,58),BackgroundTransparency=1},outer)
	local layout=New("UIListLayout", {Padding=UDim.new(0,6),SortOrder=Enum.SortOrder.LayoutOrder},list)
	local rows={}
	local function clear()
		for _,row in pairs(rows) do if row and row.Parent then row:Destroy() end end
		table.clear(rows)
	end
	local function addPlayer(plr,order)
		local row=New("TextButton", {Size=UDim2.new(1,0,0,34),BackgroundColor3=C.Panel3,BorderSizePixel=0,Text=string.format("%s  @%s",plr.DisplayName,plr.Name),TextColor3=C.White2,TextSize=9,Font=Enum.Font.Code,TextXAlignment=Enum.TextXAlignment.Left,AutoButtonColor=false,LayoutOrder=order,ZIndex=45},list)
		Corner(row,3); Stroke(row,C.Line,1,0)
