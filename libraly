local function CreateCollapseButton()
	if CollapseButton and CollapseButton.Parent then
		return CollapseButton
	end

	local button = New("TextButton", {
		Name = "MenuToggle",
		Size = UDim2.fromOffset(38, 38),
		Position = UDim2.new(0.5, -19, 0.5, -19),
		BackgroundColor3 = C.Black,
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
		Active = true,
		Selectable = false,
		ZIndex = 300
	}, Gui)

	Corner(button, 5)
	Stroke(button, C.Line2, 1, 0.05)

	local core = New("Frame", {
		Size = UDim2.fromOffset(18, 18),
		Position = UDim2.new(0.5, -9, 0.5, -9),
		BackgroundColor3 = C.Panel2,
		BorderSizePixel = 0,
		ZIndex = 301
	}, button)

	Corner(core, 3)
	Stroke(core, C.Gray2, 1, 0.2)

	-- Minimal four-corner mark instead of the old plus icon.
	local marks = {
		{UDim2.fromOffset(6, 1), UDim2.new(0, 3, 0, 3)},
		{UDim2.fromOffset(1, 6), UDim2.new(0, 3, 0, 3)},
		{UDim2.fromOffset(6, 1), UDim2.new(1, -9, 0, 3)},
		{UDim2.fromOffset(1, 6), UDim2.new(1, -4, 0, 3)},
		{UDim2.fromOffset(6, 1), UDim2.new(0, 3, 1, -4)},
		{UDim2.fromOffset(1, 6), UDim2.new(0, 3, 1, -9)},
		{UDim2.fromOffset(6, 1), UDim2.new(1, -9, 1, -4)},
		{UDim2.fromOffset(1, 6), UDim2.new(1, -4, 1, -9)}
	}

	for _, data in ipairs(marks) do
		New("Frame", {
			Size = data[1],
			Position = data[2],
			BackgroundColor3 = C.White,
			BorderSizePixel = 0,
			ZIndex = 302
		}, core)
	end

	button.MouseEnter:Connect(function()
		if not CollapseDragging then
			Tween(button, {BackgroundColor3 = C.Black2}, 0.1)
			Tween(core, {BackgroundColor3 = C.Panel3}, 0.1)
		end
	end)

	button.MouseLeave:Connect(function()
		Tween(button, {BackgroundColor3 = C.Black}, 0.1)
		Tween(core, {BackgroundColor3 = C.Panel2}, 0.1)
	end)

	button.InputBegan:Connect(function(input)
		if Destroying or Animating then
			return
		end

		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			CollapseDragging = true
			CollapseMoved = false
			CollapseDragStart = input.Position
			CollapseStartPosition = button.Position
		end
	end)

	button.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement then
			-- Mouse movement is handled globally so the button remains draggable
			-- even when the cursor leaves its 38x38 bounds.
		end
	end)

	button.MouseButton1Click:Connect(function()
		if CollapseMoved then
			return
		end
		if not Animating and not Destroying and Minimized then
			OpenMenuFromCube()
		end
	end)

	CollapseButton = button
	return button
end

function HideMenuToCube()
	if Animating or Destroying or Minimized then
		return
	end

	Animating = true
	MenuOpen = false
	Minimized = true

	local button = CreateCollapseButton()
	button.Position = UDim2.new(0.5, -19, 0.5, -19)
	button.Size = UDim2.fromOffset(4, 4)
	button.BackgroundTransparency = 1
	button.Visible = true

	for _, v in ipairs(button:GetDescendants()) do
		if v:IsA("Frame") then
			v.BackgroundTransparency = 1
		elseif v:IsA("UIStroke") then
			v.Transparency = 1
		end
	end

	-- Hide every menu element immediately. Nothing from the old menu remains
	-- visible while the small control appears.
	Menu.Visible = false

	Tween(button, {
		Size = UDim2.fromOffset(38, 38),
		Position = button.Position,
		BackgroundTransparency = 0
	}, 0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)

	for _, v in ipairs(button:GetDescendants()) do
		if v:IsA("Frame") then
			Tween(v, {BackgroundTransparency = 0}, 0.22)
		elseif v:IsA("UIStroke") then
			Tween(v, {Transparency = 0.18}, 0.22)
		end
	end

	task.delay(0.24, function()
		if not Destroying then
			Animating = false
		end
	end)
end

function OpenMenuFromCube()
	if Animating or Destroying or not Minimized then
		return
	end

	Animating = true
	Minimized = false
	MenuOpen = true

	local button = CollapseButton
	local targetPosition = Menu.Position

	Menu.Visible = true
	Menu.Size = UDim2.fromOffset(820, 520)
	Menu.BackgroundTransparency = 1
	Menu.Position = targetPosition

	if button and button.Parent then
		Tween(button, {
			Size = UDim2.fromOffset(4, 4),
			BackgroundTransparency = 1
		}, 0.18, Enum.EasingStyle.Quart, Enum.EasingDirection.In)

		for _, v in ipairs(button:GetDescendants()) do
			if v:IsA("Frame") then
				Tween(v, {BackgroundTransparency = 1}, 0.14)
			elseif v:IsA("UIStroke") then
				Tween(v, {Transparency = 1}, 0.14)
			end
		end
	end

	Tween(Menu, {
		Size = UDim2.fromOffset(900, 570),
		BackgroundTransparency = 0
	}, 0.34, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)

	for _, obj in ipairs({Header, Sidebar, Content}) do
		obj.BackgroundTransparency = 1
		Tween(obj, {BackgroundTransparency = 0}, 0.26, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	end

	task.delay(0.36, function()
		if button and button.Parent then
			button:Destroy()
		end
		CollapseButton = nil
		Animating = false
	end)
end

