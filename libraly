DestroyMenu = function()
	if Animating or Destroying then
		return
	end

	Destroying = true
	Animating = true
	MenuOpen = false
	Minimized = false

	if CollapseButton and CollapseButton.Parent then
		CollapseButton:Destroy()
		CollapseButton = nil
	end

	-- Capture the menu bounds first, then remove the complete UI immediately.
	-- Only the lightweight particles remain visible during the destruction.
	local menuWasVisible = Menu.Visible
	Menu.Visible = false

	local trash = CreateTrashCan()
	local particleLayer = New("Frame", {
		Name = "DeleteParticles",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 550
	}, Gui)

	local startX = Menu.AbsolutePosition.X
	local startY = Menu.AbsolutePosition.Y
	local width = Menu.AbsoluteSize.X
	local height = Menu.AbsoluteSize.Y

	local trashTargetX = Gui.AbsoluteSize.X / 2
	local trashTargetY = Gui.AbsoluteSize.Y - 72

	local function MakeParticle(x, y, size, binary, index)
		local holder = New("Frame", {
			Size = UDim2.fromOffset(size, size),
			Position = UDim2.fromOffset(x, y),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ZIndex = 551
		}, particleLayer)

		local square = New("Frame", {
			Size = UDim2.fromOffset(size, size),
			BackgroundColor3 = C.Black,
			BorderSizePixel = 0,
			ZIndex = 551
		}, holder)
		Corner(square, 1)

		local code = New("TextLabel", {
			Size = UDim2.fromOffset(math.max(20, size * 4), 10),
			Position = UDim2.fromOffset(-math.max(8, size * 1.5), -4),
			BackgroundTransparency = 1,
			Text = binary,
			TextColor3 = C.Gray2,
			TextSize = 7,
			Font = Enum.Font.Code,
			TextTransparency = 0.05,
			ZIndex = 552
		}, holder)

		local endX = trashTargetX - size / 2 + math.random(-18, 18)
		local endY = trashTargetY - size / 2 + math.random(-10, 12)
		local fallTime = 0.7 + (index % 7) * 0.045

		Tween(holder, {
			Position = UDim2.fromOffset(endX, endY),
			Rotation = math.random(-130, 130)
		}, fallTime, Enum.EasingStyle.Quint, Enum.EasingDirection.In)

		Tween(square, {
			BackgroundTransparency = 0.12
		}, 0.08)
		Tween(square, {
			BackgroundTransparency = 1
		}, fallTime * 0.72, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		Tween(code, {
			TextTransparency = 1
		}, fallTime * 0.82, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	end

	local binaries = {"0101", "1010", "0011", "1100", "0110", "1001", "0100", "1110"}

	-- 32 square particles + binary fragments: enough to sell the effect,
	-- without the frame explosion that caused the old animation to stutter.
	for i = 1, 32 do
		local x = startX + math.random(12, math.max(13, width - 12))
		local y = startY + math.random(12, math.max(13, height - 12))
		local size = math.random(3, 7)
		MakeParticle(x, y, size, binaries[(i - 1) % #binaries + 1], i)
	end

	-- A few larger black fragments make the menu feel like it is actually
	-- breaking apart rather than simply fading away.
	for i = 1, 8 do
		local x = startX + math.random(20, math.max(21, width - 20))
		local y = startY + math.random(20, math.max(21, height - 20))
		MakeParticle(x, y, math.random(8, 13), binaries[(i + 2) % #binaries + 1], i + 32)
	end

	-- The original menu is already hidden, so no buttons or panels can flash
	-- through the particle animation.
	if not menuWasVisible then
		Menu.Visible = false
	end

	for _, obj in ipairs(Menu:GetDescendants()) do
		if obj:IsA("TextLabel") or obj:IsA("TextButton") then
			Tween(obj, {TextTransparency = 1}, 0.48, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		elseif obj:IsA("UIStroke") then
			Tween(obj, {Transparency = 1}, 0.48, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		elseif obj:IsA("Frame") and obj ~= Menu and obj ~= Header and obj ~= Sidebar and obj ~= Content then
			Tween(obj, {BackgroundTransparency = 1}, 0.48, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		end
	end

	task.delay(0.86, function()
		if particleLayer.Parent then
			particleLayer:Destroy()
		end
		if Menu.Parent then
			Menu.Visible = false
		end
	end)

	task.delay(1.28, function()
		if trash and trash.Parent then
			Tween(trash, {
				Position = UDim2.new(0.5, -50, 1, 25)
			}, 0.38, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
		end
	end)

	task.delay(1.72, function()
		if Gui.Parent then
			Gui:Destroy()
		end
	end)
end

