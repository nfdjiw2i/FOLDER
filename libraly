		row.MouseEnter:Connect(function() Tween(row,{BackgroundColor3=C.Panel4,TextColor3=C.White},0.1) end)
		row.MouseLeave:Connect(function() Tween(row,{BackgroundColor3=C.Panel3,TextColor3=C.White2},0.1) end)
		row.MouseButton1Click:Connect(function() if callback then task.spawn(callback,plr) else if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") and Player.Character then Player.Character:PivotTo(plr.Character.HumanoidRootPart.CFrame + Vector3.new(0,3,0)) end end end)
		table.insert(rows,row)
	end
	local function refresh()
		clear()
		local listPlayers=Players:GetPlayers()
		table.sort(listPlayers,function(a,b) return string.lower(a.DisplayName)<string.lower(b.DisplayName) end)
		for i,plr in ipairs(listPlayers) do if plr ~= Player then addPlayer(plr,i) end end
		local h=layout.AbsoluteContentSize.Y
		outer.Size=UDim2.new(1,0,0,58+h)
		PlayerLists[outer]=true
	end
	Players.PlayerAdded:Connect(refresh)
	Players.PlayerRemoving:Connect(refresh)
	refresh()
	return {Frame=outer,Refresh=refresh}
end

