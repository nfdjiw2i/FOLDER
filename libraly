local function New(class, props, parent)
	local obj = Instance.new(class)

	for k, v in pairs(props or {}) do
		obj[k] = v
	end

	obj.Parent = parent
	return obj
end

local function Tween(obj, props, time, style, direction)
	if not obj or not obj.Parent then
		return
	end

	local info = TweenInfo.new(
		time or 0.25,
		style or Enum.EasingStyle.Quart,
		direction or Enum.EasingDirection.Out
	)

	local t = TweenService:Create(obj, info, props)
	t:Play()

	return t
end

local function Corner(obj, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius)
	c.Parent = obj
	return c
end

local function Stroke(obj, color, thickness, transparency)
	local s = Instance.new("UIStroke")
	s.Color = color or C.Line
	s.Thickness = thickness or 1
	s.Transparency = transparency or 0
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = obj
	return s
end

local function Label(parent, text, size, color, font)
	return New("TextLabel", {
		BackgroundTransparency = 1,
		Text = text,
		TextSize = size or 10,
		TextColor3 = color or C.White,
		Font = font or Enum.Font.Code,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center
	}, parent)
end

local function AddSoftGrid(parent)
	local grid = New("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		ZIndex = 1
	}, parent)

	for i = 0, 9 do
		New("Frame", {
			Size = UDim2.new(1, 0, 0, 1),
			Position = UDim2.new(0, 0, i / 9, 0),
			BackgroundColor3 = C.White,
			BackgroundTransparency = 0.975,
			BorderSizePixel = 0
		}, grid)
	end

	return grid
end

local function CreateGlow(parent, size, position, transparency)
	local glow = New("Frame", {
		Size = UDim2.fromOffset(size, size),
		Position = position,
		BackgroundColor3 = C.White,
		BackgroundTransparency = transparency or 0.985,
		BorderSizePixel = 0
	}, parent)

	Corner(glow, size / 2)

	return glow
end

local function CreateCircle(parent, size, position, transparency)
	local circle = New("Frame", {
		Size = UDim2.fromOffset(size, size),
		Position = position,
		BackgroundTransparency = 1,
		BorderSizePixel = 0
	}, parent)

	Corner(circle, size / 2)
	Stroke(circle, C.White, 1, transparency or 0.94)

	return circle
end

local function FadeObject(obj, value, time)
	if obj:IsA("TextLabel") or obj:IsA("TextButton") then
		Tween(obj, {
			TextTransparency = value
		}, time)
	elseif obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
		Tween(obj, {
			ImageTransparency = value
		}, time)
	elseif obj:IsA("Frame") then
		Tween(obj, {
			BackgroundTransparency = value
		}, time)
	end

	local stroke = obj:FindFirstChildOfClass("UIStroke")

	if stroke then
		Tween(stroke, {
			Transparency = math.clamp(value, 0, 1)
		}, time)
	end
end

local function GetGreetingData()
	local now = os.date("*t")

	local hour = now.hour

	local state

	if Lighting.ClockTime >= 6 and Lighting.ClockTime < 18 then
		state = "DAY"
	else
		state = "NIGHT"
	end

	local greeting

	if hour >= 5 and hour < 12 then
		greeting = "GOOD MORNING"
	elseif hour >= 12 and hour < 18 then
		greeting = "GOOD AFTERNOON"
	elseif hour >= 18 and hour < 23 then
		greeting = "GOOD EVENING"
	else
		greeting = "GOOD NIGHT"
	end

	local timeString = string.format(
		"%02d:%02d:%02d",
		now.hour,
		now.min,
		now.sec
	)

	local dateString = string.format(
		"%02d.%02d.%04d",
		now.day,
		now.month,
		now.year
	)

	return timeString, state, dateString, greeting
end

