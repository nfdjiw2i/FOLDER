	end
	bar.InputBegan:Connect(function(input) if input.UserInputType==Enum.UserInputType.MouseButton1 then dragging=true; SetFromX(input.Position.X,true) end end)
	UserInputService.InputChanged:Connect(function(input) if dragging and input.UserInputType==Enum.UserInputType.MouseMovement then SetFromX(input.Position.X,true) end end)
	UserInputService.InputEnded:Connect(function(input) if input.UserInputType==Enum.UserInputType.MouseButton1 then dragging=false end end)
	return {Frame=f, Get=function() return value end, Set=function(v,fire) v=math.clamp(tonumber(v) or min,min,max); local rel=(v-min)/(max-min==0 and 1 or max-min); value=v; fill.Size=UDim2.new(rel,0,1,0); knob.Position=UDim2.new(rel,-4,0.5,-4); valueLabel.Text=tostring(v); if fire ~= false and callback then task.spawn(callback,v) end end}
end

