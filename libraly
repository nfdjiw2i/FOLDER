local function CreateSlider(parent,title,description,min,max,default,callback)
	min=tonumber(min) or 0; max=tonumber(max) or 100; default=tonumber(default) or min
	if max < min then min,max=max,min end
	default=math.clamp(default,min,max)
	local f=ControlFrame(parent,70)
	local titleLabel=Label(f,title,10,C.White,Enum.Font.Code); titleLabel.Size=UDim2.new(0.6,0,0,20); titleLabel.Position=UDim2.new(0,13,0,7)
	local valueLabel=Label(f,tostring(default),9,C.White,Enum.Font.Code); valueLabel.Size=UDim2.fromOffset(65,20); valueLabel.Position=UDim2.new(1,-78,0,7); valueLabel.TextXAlignment=Enum.TextXAlignment.Right
	local desc=Label(f,description or "",8,C.Gray2,Enum.Font.Code); desc.Size=UDim2.new(1,-26,0,16); desc.Position=UDim2.new(0,13,0,28)
	local bar=New("Frame", {Size=UDim2.new(1,-26,0,3), Position=UDim2.new(0,13,1,-13), BackgroundColor3=C.Panel4, BorderSizePixel=0, ZIndex=42}, f); Corner(bar,2)
	local ratio=(default-min)/(max-min == 0 and 1 or max-min)
	local fill=New("Frame", {Size=UDim2.new(ratio,0,1,0), BackgroundColor3=C.White, BorderSizePixel=0, ZIndex=43}, bar); Corner(fill,2)
	local knob=New("Frame", {Size=UDim2.fromOffset(9,9), Position=UDim2.new(ratio,-4,0.5,-4), BackgroundColor3=C.White, BorderSizePixel=0, ZIndex=44}, bar); Corner(knob,5)
	local value=default; local dragging=false
	local function SetFromX(x, fire)
		local rel=math.clamp((x-bar.AbsolutePosition.X)/math.max(1,bar.AbsoluteSize.X),0,1)
		value=min+(max-min)*rel
