local function RunSplash()
	if not IntroText then
		if Splash and Splash.Parent then Splash:Destroy() end
		return
	end

	Splash.Visible = true
	Splash.BackgroundTransparency = 0
	SplashTitle.Text = IntroText
	SplashTitle.TextTransparency = 0
	SplashStatus.TextTransparency = 0
	LoadBack.BackgroundTransparency = 0
	LoadFill.BackgroundTransparency = 0
	LoadFill.Size = UDim2.new(0,0,1,0)

	for i=0,100 do
		LoadFill.Size=UDim2.new(i/100,0,1,0)
		if i<25 then SplashStatus.Text="INITIALIZING // "..string.format("%02d",i).."%"
		elseif i<50 then SplashStatus.Text="LOADING CORE // "..string.format("%02d",i).."%"
		elseif i<75 then SplashStatus.Text="BUILDING UI // "..string.format("%02d",i).."%"
		elseif i<95 then SplashStatus.Text="FINALIZING // "..string.format("%02d",i).."%"
		else SplashStatus.Text="READY // "..string.format("%02d",i).."%" end
		task.wait(0.008)
	end

	if GreetingText then
		Greeting.Visible=true
		Greeting.BackgroundTransparency=0
	end

	Tween(SplashTitle,{TextTransparency=1},0.28)
	Tween(SplashStatus,{TextTransparency=1},0.28)
	Tween(LoadBack,{BackgroundTransparency=1},0.28)
	Tween(LoadFill,{BackgroundTransparency=1},0.28)
	for _,v in ipairs(Splash:GetDescendants()) do
		if v:IsA("UIStroke") then Tween(v,{Transparency=1},0.28)
		elseif v:IsA("Frame") and v~=Splash then Tween(v,{BackgroundTransparency=1},0.28) end
	end
	Tween(Splash,{BackgroundTransparency=1},0.32)
	task.wait(0.33)
	if Splash and Splash.Parent then Splash:Destroy() end
end

