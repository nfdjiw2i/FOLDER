local GreetingConnection

local function RunGreeting()
	if not GreetingText then
		if Greeting and Greeting.Parent then Greeting:Destroy() end
		return
	end

	Greeting.Visible=true
	Greeting.BackgroundTransparency=0
	Hello.Text="HELLO, "..string.upper(Player.DisplayName)
	Welcome.Text=GreetingText
	Hello.TextTransparency=1; Username.TextTransparency=1; Clock.TextTransparency=1; Environment.TextTransparency=1; Welcome.TextTransparency=1
	GreetingBox.Position=UDim2.new(0.5,-270,0.5,-95)

	local function UpdateGreeting()
		if not Greeting.Parent then return end
		local timeString,state,dateString=GetGreetingData()
		Clock.Text=timeString
		Environment.Text=state.." // "..dateString
	end
	UpdateGreeting()
	GreetingConnection=RunService.RenderStepped:Connect(UpdateGreeting)

	Tween(GreetingBox,{Position=UDim2.new(0.5,-270,0.5,-125)},0.65,Enum.EasingStyle.Quart)
	Tween(Hello,{TextTransparency=0},0.55)
	task.wait(0.10)
	Tween(Username,{TextTransparency=0},0.45)
	task.wait(0.08)
	Tween(Clock,{TextTransparency=0},0.45)
	Tween(Environment,{TextTransparency=0},0.45)
	task.wait(0.08)
	Tween(Welcome,{TextTransparency=0},0.45)
	task.wait(2.0)

	for _,obj in ipairs({Hello,Username,Clock,Environment,Welcome}) do Tween(obj,{TextTransparency=1},0.75) end
	Tween(GreetingBox,{Position=UDim2.new(0.5,-270,0.5,-145)},0.75,Enum.EasingStyle.Quart)
	for _,obj in ipairs(Greeting:GetDescendants()) do
		if obj:IsA("UIStroke") then Tween(obj,{Transparency=1},0.75)
		elseif obj:IsA("Frame") and obj~=GreetingBox then Tween(obj,{BackgroundTransparency=1},0.75) end
	end
	Tween(Greeting,{BackgroundTransparency=1},0.75)
	task.wait(0.76)
	if GreetingConnection then GreetingConnection:Disconnect(); GreetingConnection=nil end
	if Greeting and Greeting.Parent then Greeting:Destroy() end
end

