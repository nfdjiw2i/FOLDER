task.spawn(function()
	-- The caller configures Intro/Greeting immediately after CreateLib.
	-- Starting one deferred task prevents the default Roblox loading screen from flashing.
	task.wait()
	if Greeting and Greeting.Parent then
		Greeting.Visible = GreetingText ~= nil
		Greeting.BackgroundTransparency = 0
	end
	if IntroText then
		RunSplash()
	end
	if GreetingText then
		RunGreeting()
	end
	ShowMenu()
	StartupStarted=true
end)

-- Keybind dispatcher.
UserInputService.InputBegan:Connect(function(input, processed)
	if processed or Destroying then return end
	for _,bind in ipairs(Keybinds) do
		if bind.IsListening() then
			if input.UserInputType == Enum.UserInputType.Keyboard then
				bind.Finish(input.KeyCode)
				break
			end
		elseif input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == bind.GetKey() then
			bind.Callback()
		end
	end
end)


